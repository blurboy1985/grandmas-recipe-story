{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grandma-recipe",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-28",
  "routes": [
    {
      "pattern": "grandma-recipe.danielquek.com",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "GrandmaContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "app": {
          "image": "registry.cloudflare.com/2b1f3493e8bbdea98825e1c13bf04a66/grandma-recipe-grandmacontainer@sha256:c2b68f9d3df1296a6d56d5f161a62d498da6422ab82a79ba3516048610c8b318"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GRANDMA_CONTAINER",
        "class_name": "GrandmaContainer"
      }
    ]
  },
  "exports": {
    "GrandmaContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "APP_MODE": "sample"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
