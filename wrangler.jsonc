{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grandma-recipe",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-28",
  "routes": [
    {
      "pattern": "grandma-recipe.danielquek.com",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "GrandmaContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "app": {
          "image": "registry.cloudflare.com/2b1f3493e8bbdea98825e1c13bf04a66/grandma-recipe-grandmacontainer@sha256:4345521b5e09545fffd71378de712162b38fa1a892658d4a964aa87c523f34db"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GRANDMA_CONTAINER",
        "class_name": "GrandmaContainer"
      }
    ]
  },
  "exports": {
    "GrandmaContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "APP_MODE": "sample"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
