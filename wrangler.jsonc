{
  // PRODUCTION — plain Worker + static assets (Worker migration).
  // Same shape as wrangler.staging.jsonc (verified on
  // grandma-recipe-staging), PLUS the custom-domain route.
  // Phase 8 cleanup (after the 14-day soak, Daniel's go-ahead 22 Nov
  // 2026) removes the container/DO leftovers in two deploys:
  //   Deploy 1 (this config): the GRANDMA_CONTAINER durable_objects
  //     binding is removed. The GrandmaContainer class export and the
  //     `exports` declaration stay for now — no class deletion yet.
  //   Deploy 2 (separate): the class export + `exports` block are
  //     removed and the Durable Object class is deleted via an explicit
  //     wrangler migration (deleted_classes).
  // The old `containers:` image block was already dropped at the
  // Phase 7 cutover (the scoped API token cannot prepare container
  // images). META_API_KEY is a secret binding managed outside this
  // file (wrangler secret / dashboard); it is not defined here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grandma-recipe",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "grandma-recipe.danielquek.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/recipes/*"
    ]
  },
  "exports": {
    "GrandmaContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "APP_MODE": "sample",
    "RECIPE_MODEL": "muse-spark-1.3"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
